CAPI=2:
# Copyright lowRISC contributors (OpenTitan project).
# Licensed under the Apache License, Version 2.0, see LICENSE for details.
# SPDX-License-Identifier: Apache-2.0
name: "lowrisc:fpv:hmac_fpv:0.1"
description: "hmac FPV target"
filesets:
  files_formal:
    depend:
      - lowrisc:prim:all
      - lowrisc:fpv:csr_assert_gen
      - lowrisc:ip:tlul
      - lowrisc:fpv:csr_assert_gen
      - lowrisc:ip:hmac
      - lowrisc:fpv:csr_assert_gen
      # TODO: add more dependencies here if needed
    files:
      - vip/hmac_assert_fpv.sv
      - tb/hmac_bind_fpv.sv
      - tb/hmac_tb.sv
    file_type: systemVerilogSource

generate:
  csr_assert_gen:
    generator: csr_assert_gen
    parameters:
      spec: ../data/hmac.hjson
      depend: lowrisc:ip:hmac

targets:
  default: &default_target
    # note, this setting is just used
    # to generate a file list for jg
    default_tool: icarus
    filesets:
      - files_formal
    generate:
      - csr_assert_gen
    toplevel: hmac_tb

  formal:
    <<: *default_target

  lint:
    <<: *default_target
