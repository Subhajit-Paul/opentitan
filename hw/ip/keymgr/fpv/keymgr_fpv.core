name: "lowrisc:fpv:keymgr_fpv:0.1"
description: "keymgr FPV target"
filesets:
  files_formal:
    depend:
      - lowrisc:prim:all
      - lowrisc:ip:keymgr:0.1
      # TODO: add more dependencies here if needed
    files:
      - vip/keymgr_assert_fpv.sv
      - tb/keymgr_bind_fpv.sv
      - tb/keymgr_tb.sv
    file_type: systemVerilogSource


targets:
  default: &default_target
    # note, this setting is just used
    # to generate a file list for jg
    default_tool: icarus
    filesets:
      - files_formal
    toplevel: keymgr_tb

  formal:
    <<: *default_target

  lint:
    <<: *default_target
