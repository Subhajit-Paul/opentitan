name: "lowrisc:fpv:sram_ctrl_fpv:0.1"
description: "sram_ctrl FPV target"
filesets:
  files_formal:
    depend:
      - lowrisc:prim:all
      - lowrisc:ip:sram_ctrl:0.1
      # TODO: add more dependencies here if needed
    files:
      - vip/sram_ctrl_assert_fpv.sv
      - tb/sram_ctrl_bind_fpv.sv
      - tb/sram_ctrl_tb.sv
    file_type: systemVerilogSource


targets:
  default: &default_target
    # note, this setting is just used
    # to generate a file list for jg
    default_tool: icarus
    filesets:
      - files_formal
    toplevel: sram_ctrl_tb

  formal:
    <<: *default_target

  lint:
    <<: *default_target
