name: "lowrisc:fpv:uart_fpv:0.1"
description: "uart FPV target"
filesets:
  files_formal:
    depend:
      - lowrisc:prim:all
      - lowrisc:ip:uart:0.1
      # TODO: add more dependencies here if needed
    files:
      - vip/uart_assert_fpv.sv
      - tb/uart_bind_fpv.sv
      - tb/uart_tb.sv
    file_type: systemVerilogSource


targets:
  default: &default_target
    # note, this setting is just used
    # to generate a file list for jg
    default_tool: icarus
    filesets:
      - files_formal
    toplevel: uart_tb

  formal:
    <<: *default_target

  lint:
    <<: *default_target
